<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:paddingBottom="4dp">

    <View
        android:id="@+id/indicador_secao_novidade"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/aviso_badge_verde"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/text_secao_titulo"
        app:layout_constraintBottom_toBottomOf="@id/text_secao_titulo" />

    <TextView
        android:id="@+id/text_secao_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:paddingHorizontal="4dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:alpha="0.9"
        app:layout_constraintStart_toEndOf="@id/indicador_secao_novidade"
        app:layout_constraintEnd_toStartOf="@id/button_secao_colapsar"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/button_secao_colapsar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="4dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_chevron_down"
        android:contentDescription="@string/content_description_aviso_section_collapse"
        app:layout_constraintEnd_toStartOf="@id/button_secao_options"
        app:layout_constraintTop_toTopOf="@id/text_secao_titulo"
        app:layout_constraintBottom_toBottomOf="@id/text_secao_titulo" />

    <TextView
        android:id="@+id/text_secao_subtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginStart="6dp"
        android:paddingHorizontal="4dp"
        android:textColor="@color/white"
        android:alpha="0.6"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/indicador_secao_novidade"
        app:layout_constraintEnd_toStartOf="@id/button_secao_options"
        app:layout_constraintTop_toBottomOf="@id/text_secao_titulo" />

    <ImageButton
        android:id="@+id/button_secao_aviso_cartao"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_alerta_triangulo"
        android:contentDescription="@string/content_description_aviso_cartao_alterado"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/button_secao_options"
        app:layout_constraintTop_toTopOf="@id/text_secao_subtitulo"
        app:layout_constraintBottom_toBottomOf="@id/text_secao_subtitulo" />

    <ImageButton
        android:id="@+id/button_secao_options"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:src="@drawable/tres_pontos"
        android:contentDescription="@string/content_description_aviso_section_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/text_secao_titulo"
        app:layout_constraintBottom_toBottomOf="@id/text_secao_titulo" />

    <View
        android:id="@+id/divider_secao"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/white"
        android:alpha="0.15"
        app:layout_constraintTop_toBottomOf="@id/text_secao_subtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
