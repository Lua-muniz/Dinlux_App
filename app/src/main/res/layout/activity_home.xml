<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/drawer_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray"
        tools:context=".home.Home"
        >

        <ImageButton
            android:id="@+id/button_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="6dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/content_description_menu_lateral"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/button_menu"
            app:layout_constraintBottom_toBottomOf="@id/button_menu"
            />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_boas_vindas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/dashboard_card_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_menu"
            tools:visibility="visible"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_boas_vindas_titulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        tools:text="Bem-vindo(a) ao Dinlux, Luana!" />

                    <ImageButton
                        android:id="@+id/button_fechar_boas_vindas"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_close"
                        android:contentDescription="@string/content_description_fechar_boas_vindas" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/Boas_Vindas_Dica"
                    android:textColor="@color/white"
                    android:alpha="0.85"
                    android:textSize="13sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/container_dashboard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_boas_vindas"
            app:layout_constraintBottom_toTopOf="@id/finance"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@android:color/transparent">

                <TextView
                    android:id="@+id/tab_dashboard_simulacoes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:paddingVertical="8dp"
                    android:gravity="center"
                    android:text="@string/dashboard_tab_simulacoes"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/shape_tab_pill" />

                <TextView
                    android:id="@+id/tab_dashboard_movimentacoes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:paddingVertical="8dp"
                    android:gravity="center"
                    android:text="@string/dashboard_tab_movimentacoes"
                    android:textColor="@color/white"
                    android:alpha="0.6"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tab_dashboard_cartoes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:paddingVertical="8dp"
                    android:gravity="center"
                    android:text="@string/dashboard_tab_cartoes"
                    android:textColor="@color/white"
                    android:alpha="0.6"
                    android:textStyle="bold"
                    android:textSize="12sp" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_dashboard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <ProgressBar
                    android:id="@+id/progress_dashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/cyan"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tutorial"
            style="@style/ButtonSimple"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/finance"
            app:layout_constraintBottom_toTopOf="@id/textTutorial"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textTutorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Tutorial"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tutorial"
            app:layout_constraintEnd_toEndOf="@id/tutorial"
            app:layout_constraintBottom_toTopOf="@id/list"
            android:layout_marginBottom="14dp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_tutorial"
            android:elevation="10dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="@id/tutorial"
            app:layout_constraintTop_toTopOf="@id/tutorial"
            app:layout_constraintEnd_toEndOf="@id/tutorial"
            app:layout_constraintBottom_toBottomOf="@id/tutorial"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/finance"
            style="@style/ButtonSimple"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textFinance"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textFinance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Financa"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/finance"
            app:layout_constraintStart_toStartOf="@id/finance"
            app:layout_constraintBottom_toTopOf="@id/insertExcerpt"
            android:layout_marginBottom="14dp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_finance"
            android:elevation="10dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="@id/finance"
            app:layout_constraintTop_toTopOf="@id/finance"
            app:layout_constraintEnd_toEndOf="@id/finance"
            app:layout_constraintBottom_toBottomOf="@id/finance"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/simulation"
            style="@style/ButtonSimple"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/finance"
            app:layout_constraintBottom_toTopOf="@id/texSimulation"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/texSimulation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Simulacoes"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/simulation"
            app:layout_constraintStart_toStartOf="@id/simulation"
            app:layout_constraintBottom_toTopOf="@id/warning"
            android:layout_marginBottom="14dp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_simulation"
            android:elevation="10dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="@id/simulation"
            app:layout_constraintTop_toTopOf="@id/simulation"
            app:layout_constraintEnd_toEndOf="@id/simulation"
            app:layout_constraintBottom_toBottomOf="@id/simulation"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/list"
            style="@style/ButtonSimple"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/insertExcerpt"
            app:layout_constraintBottom_toTopOf="@id/textlist"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Listas"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/list"
            app:layout_constraintEnd_toEndOf="@id/list"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_list"
            android:elevation="10dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="@id/list"
            app:layout_constraintTop_toTopOf="@id/list"
            app:layout_constraintEnd_toEndOf="@id/list"
            app:layout_constraintBottom_toBottomOf="@id/list"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/insertExcerpt"
            style="@style/ButtonSimple"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/texInsertExcerpt"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/texInsertExcerpt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Inserir_Extrato"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/insertExcerpt"
            app:layout_constraintEnd_toEndOf="@id/insertExcerpt"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_insert_excerpt"
            android:elevation="10dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="@id/insertExcerpt"
            app:layout_constraintTop_toTopOf="@id/insertExcerpt"
            app:layout_constraintEnd_toEndOf="@id/insertExcerpt"
            app:layout_constraintBottom_toBottomOf="@id/insertExcerpt"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/warning"
            style="@style/ButtonSimple"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:layout_constraintStart_toEndOf="@id/insertExcerpt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textWarning"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/text_warning_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/shape_circle"
            android:backgroundTint="@color/aviso_badge_verde"
            android:gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="10sp"
            android:visibility="gone"
            android:elevation="12dp"
            android:layout_marginTop="-6dp"
            android:layout_marginEnd="-6dp"
            app:layout_constraintTop_toTopOf="@id/warning"
            app:layout_constraintEnd_toEndOf="@id/warning"
            tools:visibility="visible"
            tools:text="9" />

        <TextView
            android:id="@+id/textWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Avisos"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/warning"
            app:layout_constraintEnd_toEndOf="@id/warning"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_warning"
            android:elevation="10dp"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintStart_toStartOf="@id/warning"
            app:layout_constraintTop_toTopOf="@id/warning"
            app:layout_constraintEnd_toEndOf="@id/warning"
            app:layout_constraintBottom_toBottomOf="@id/warning"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/panel_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
