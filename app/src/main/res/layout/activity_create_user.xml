<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".authentication.CreateUser"
    >

    <ImageView
        android:id="@+id/logo_d"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/d"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

        <View
            android:id="@+id/conteiner_componentes"
            style="@style/ContainerComponents"
            android:layout_width="374dp"
            android:layout_height="651dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo_d" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_name"
        style="@style/boxInformation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        app:endIconDrawable="@drawable/ic_user"
        app:hintTextColor="@color/black"
        app:counterEnabled="true"
        app:counterMaxLength="35"
        android:hint="Nome"
        app:layout_constraintStart_toStartOf="@id/conteiner_componentes"
        app:layout_constraintEnd_toEndOf="@id/conteiner_componentes"
        app:layout_constraintTop_toTopOf="@id/conteiner_componentes">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/ic_user"
            android:inputType="text"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_email"
        style="@style/boxInformation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:counterMaxLength="320"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        app:hintTextColor="@color/black"
        android:hint="Email"
        app:endIconDrawable="@drawable/ic_email"
        app:layout_constraintStart_toStartOf="@id/conteiner_componentes"
        app:layout_constraintEnd_toEndOf="@id/conteiner_componentes"
        app:layout_constraintTop_toBottomOf="@id/layout_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/ic_email"
            android:inputType="textEmailAddress" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_password"
        style="@style/boxInformation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="40dp"
        app:hintTextColor="@color/black"
        android:hint="Senha"
        android:textColorHint="#979696"
        app:counterMaxLength="25"
        app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="@id/conteiner_componentes"
        app:layout_constraintStart_toStartOf="@id/conteiner_componentes"
        app:layout_constraintTop_toBottomOf="@id/layout_email">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/text_terms_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:text="@string/title_terms"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@id/conteiner_componentes"
        app:layout_constraintEnd_toEndOf="@id/conteiner_componentes"
        app:layout_constraintTop_toBottomOf="@id/layout_password" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_terms"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/shape_terms_box"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="@id/conteiner_componentes"
        app:layout_constraintEnd_toEndOf="@id/conteiner_componentes"
        app:layout_constraintTop_toBottomOf="@id/text_terms_title">

        <TextView
            android:id="@+id/text_terms_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            tools:text="Texto dos Termos de Privacidade..." />

    </androidx.core.widget.NestedScrollView>

    <CheckBox
        android:id="@+id/checkbox_terms_accept"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:text="@string/label_terms_checkbox"
        android:textColor="@color/black"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/conteiner_componentes"
        app:layout_constraintEnd_toEndOf="@id/conteiner_componentes"
        app:layout_constraintTop_toBottomOf="@id/scroll_terms" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_create"
        style="@style/Button"
        android:text="@string/Criar_Conta"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/conteiner_componentes"
        app:layout_constraintEnd_toEndOf="@id/conteiner_componentes"
        app:layout_constraintTop_toBottomOf="@id/checkbox_terms_accept"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="30dp"
        android:layout_height="50dp"
        />

    <View
        android:id="@+id/spacer_bottom_container"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="@id/button_create"
        app:layout_constraintEnd_toEndOf="@id/button_create"
        app:layout_constraintTop_toBottomOf="@id/button_create" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/black"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/button_create"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkbox_terms_accept"
        />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
