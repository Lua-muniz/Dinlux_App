<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/dashboard_card_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/row_dashboard_card_title"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:id="@+id/dot_dashboard_card_color"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_circle"
                tools:backgroundTint="@color/node_color_04" />

            <TextView
                android:id="@+id/text_dashboard_card_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                tools:text="MarcaDeCartao" />

            <TextView
                android:id="@+id/text_dashboard_card_bank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/white"
                android:alpha="0.55"
                android:textSize="12sp"
                tools:text="Banco do Brasil" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.luamuniz.dinlux.graphics.DashboardCardDonutChartView
                android:id="@+id/chart_dashboard_card_donut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/text_dashboard_card_closing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:alpha="0.85"
                    android:textSize="13sp"
                    tools:text="Fechamento: dia 10" />

                <TextView
                    android:id="@+id/text_dashboard_card_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:alpha="0.85"
                    android:textSize="13sp"
                    tools:text="Vencimento: dia 20" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_dashboard_card_usado"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/extrato_saida" />

            <TextView
                android:id="@+id/text_dashboard_card_usado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:alpha="0.85"
                android:textSize="13sp"
                tools:text="Usado: R$ 350,00 (35%)" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_dashboard_card_disponivel"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/extrato_entrada" />

            <TextView
                android:id="@+id/text_dashboard_card_disponivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:alpha="0.85"
                android:textSize="13sp"
                tools:text="Disponível: R$ 650,00 (65%)" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
